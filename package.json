{
  "name": "catapult-siege",
  "version": "1.5.0",
  "description": "Catapult Siege: Осадный расчёт — 3D touch-controlled siege artillery game for Android",
  "type": "module",
  "scripts": {
    "dev": "node tools/build.mjs --dev && node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "test": "node tools/headless-test.mjs",
    "balance": "node tools/balance-report.mjs",
    "sync": "npm run build && npx cap sync android",
    "apk:debug": "node tools/gradle.mjs assembleDebug",
    "apk:release": "node tools/gradle.mjs assembleRelease",
    "build:dev": "node tools/build.mjs --dev",
    "serve": "node tools/serve.mjs",
    "e2e": "node tools/test-browser.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "esbuild": "^0.28.2",
    "puppeteer": "^23.11.1",
    "three": "^0.186.1"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1"
  }
}
