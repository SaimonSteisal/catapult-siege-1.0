{
  "appId": "ru.siege.catapult",
  "appName": "Catapult Siege",
  "webDir": "dist",
  "server": { "androidScheme": "https", "allowNavigation": [] },
  "backgroundColor": "#161310",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#161310",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#161310", "overlaysWebView": true }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#161310"
  }
}
